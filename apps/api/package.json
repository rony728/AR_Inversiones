{
  "name": "ar-inversiones-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "node --import tsx --test",
    "backup": "node scripts/backup-database.mjs",
    "restore": "node scripts/restore-database.mjs",
    "export:data": "node scripts/export-data.mjs",
    "migration:dry-run": "node scripts/migrate-stage11.mjs --dry-run ../../AR_Inversiones_Migracion_V2.xlsx",
    "migration:apply": "node scripts/migrate-stage11.mjs --apply ../../AR_Inversiones_Migracion_V2.xlsx --config ../../database/migration/stage11-input.json"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "pino-http": "^10.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.21",
    "@types/pg": "^8.15.4",
    "supertest": "^7.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
