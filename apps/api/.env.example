NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://ar_inversiones:CAMBIAR@localhost:5432/ar_inversiones
JWT_SECRET=use-una-clave-larga-aleatoria-de-al-menos-32-caracteres
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173
HOST=127.0.0.1
TRUST_PROXY=false
DATABASE_SSL=false
REQUEST_BODY_LIMIT=1mb
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Checkout AR Accesorios: desactivado hasta confirmar operacion y pruebas
STORE_CHECKOUT_ENABLED=false
STORE_SHIPPING_PAYMENT_ENABLED=false
STORE_PICKUP_ENABLED=true
STORE_SHIPPING_ENABLED=true
STORE_SHIPPING_FEE_HNL=100
STORE_PICKUP_LOCATION=Comayagua, segunda planta de Gaby's Tech, bulevar Cuarto Centenario, contiguo a Ferretería Famaco; subir las escaleras metálicas grises.
STORE_SHIPPING_COVERAGE=Toda Honduras
STORE_DELIVERY_ESTIMATE=1 a 3 días, estimado y sujeto a confirmación
